# Server-only values. Never prefix secrets with VITE_.
# Copy this file to .env.local for local development; do not commit .env.local.
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Required on Vercel. Leave both blank locally to use existing .chat-data files.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
